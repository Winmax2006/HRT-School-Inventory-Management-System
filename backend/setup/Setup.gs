  function initDatabase() {
    const tableNames = Object.values(Schema.TABLES);

    // 1. Initialize sheets & headers
    tableNames.forEach(tName => {
      Database.getSheet(tName);
    });

    // 2. Seed Users
    AuthService.ensureDefaultUsers();

    // 3. Seed Items & Initial Ledger
    const existingItems = Repository.findAll(Schema.TABLES.MASTER_ITEMS);
    if (!existingItems || existingItems.length === 0) {
      const currentYear = IdService.getBuddhistYear();
      const itemsToInsert = [];
      const ledgerToInsert = [];

      SEED_ITEMS.forEach((raw, idx) => {
        const itemObj = {
          item_id: `ITM-${raw[0]}`,
          item_code: raw[0],
          item_name: raw[1],
          category: raw[2],
          warehouse: raw[4],
          unit: raw[3],
          unit_price: raw[5],
          min_stock: raw[6],
          rop: raw[6],
          current_stock: raw[7],
          supplier: 'องค์การค้า สกสค. / ผู้จัดจำหน่ายคู่สัญญา',
          status: 'ACTIVE',
          updated_at: new Date().toISOString()
        };
        itemsToInsert.push(itemObj);

        // Matching opening stock entry in Stock_Ledger
        ledgerToInsert.push({
          ledger_id: IdService.generateLedgerId(idx + 1, currentYear),
          item_id: itemObj.item_id,
          item_code: itemObj.item_code,
          transaction_id: `TX-INIT-${IdService.padZero(idx + 1, 4)}`,
          transaction_type: 'ยอดยกมา',
          qty_in: raw[7],
          qty_out: 0,
          unit_cost: raw[5],
          balance_after: raw[7],
          fiscal_year: String(currentYear),
          actor_user_id: 'SYSTEM',
          created_at: new Date().toISOString(),
          reference_type: 'OPENING_BALANCE',
          reference_id: `INIT-${currentYear}`,
          note: 'ยอดยกมาตั้งต้นฐานข้อมูล'
        });
      });

      Repository.insertBatch(Schema.TABLES.MASTER_ITEMS, itemsToInsert);
      Repository.insertBatch(Schema.TABLES.STOCK_LEDGER, ledgerToInsert);
    }

    // 4. Seed sample Transactions
    const existingTxs = Repository.findAll(Schema.TABLES.TRANSACTIONS);
    if (!existingTxs || existingTxs.length === 0) {
      const txsToInsert = SEED_TRANSACTIONS.map(raw => ({
        transaction_id: raw[0],
        doc_no: `DOC-${raw[0]}`,
        type: raw[3],
        date: raw[1],
        teacher: raw[5],
        department: 'งานวิชาการ / บริหาร',
        item_code: raw[2],
        quantity: raw[4],
        status: 'COMPLETED'
      }));
      Repository.insertBatch(Schema.TABLES.TRANSACTIONS, txsToInsert);
    }

    return {
      success: true,
      message: 'HRT School Inventory Database initialized and seeded successfully.',
      tablesInitialized: tableNames.length
    };
  }

  return {
    initDatabase
  };
