# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Code and markup
*.gs text eol=lf
*.js text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows command scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary documents and archives
*.pdf binary
*.xlsx binary
*.xls binary
*.zip binary
*.rar binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
